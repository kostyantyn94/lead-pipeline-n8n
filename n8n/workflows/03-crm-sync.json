  "name": "03 CRM sync",
  "nodes": [
    {
      "parameters": {
        "content": "## 03 CRM sync\nQualified leads become CRM contacts through the HubSpot CRM v3 contacts API (search by email → create or update). The bundled mock speaks the same subset, so CRM_BASE_URL is the only switch. Idempotent: a lead is pushed once (crm_id), and a schedule retries leads that failed to sync.",
        "width": 560,
        "height": 160,
        "color": 7
      },
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        -200
      ],
      "id": "lp03crmsync00001-01"
    },
    {
      "parameters": {},
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        40,
        40
      ],
      "id": "lp03crmsync00001-02"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        40,
        230
      ],
      "id": "lp03crmsync00001-03"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select id as lead_id from leads where decision = 'qualified' and crm_id is null order by id limit 50",
        "options": {}
      },
