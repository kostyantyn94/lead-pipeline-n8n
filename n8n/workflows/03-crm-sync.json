          "id": "pgleads000000001",
          "name": "Postgres leads"
        }
      },
      "id": "lp03crmsync00001-04"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from leads where id = $1",
        "options": {
