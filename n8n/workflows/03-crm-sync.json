    {
      "parameters": {
        "jsCode": "// Maps a qualified lead to HubSpot CRM v3 contact properties (standard properties only, so it works on a fresh\n// HubSpot account; map score/segment to custom properties if your portal has them). Pure function, unit-tested.\nfunction main(items) {\n  return items.map((lead) => {\n    const tag = `[lead-pipeline] decision=${lead.decision} by=${lead.decided_by} score=${lead.score ?? 'n/a'} segment=${lead.segment ?? 'n/a'}`;\n    const properties = {\n      email: lead.email || undefined,\n      phone: lead.phone || undefined,\n      firstname: lead.first_name || undefined,\n      lastname: lead.last_name || undefined,\n      company: lead.company || undefined,\n      jobtitle: lead.job_title || undefined,\n      website: lead.domain || undefined,\n      country: lead.country || undefined,\n      hs_lead_status: 'NEW',\n      message: [\n        tag,\n        lead.reason ? `reason: ${lead.reason}` : null,\n        lead.opener ? `opener: ${lead.opener}` : null,\n        lead.message ? `original message: ${lead.message}` : null,\n      ].filter(Boolean).join('\\n'),\n    };\n    for (const k of Object.keys(properties)) if (properties[k] === undefined) delete properties[k];\n    return { lead_id: lead.id, email: lead.email || '', phone: lead.phone || '', properties };\n  });\n}\n\nreturn main($input.all().map((i) => i.json), {}).map((json) => ({ json }));"
      },
      "name": "Contact properties",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        40
      ],
      "id": "lp03crmsync00001-09"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.crm_base_url + '/crm/v3/objects/contacts/search' }}",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.crm_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [ { filters: [ { propertyName: $json.email ? 'email' : 'phone', operator: 'EQ', value: $json.email || $json.phone } ] } ], properties: ['email'], limit: 1 }) }}"
      },
      "name": "Search contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1860,
        40
      ],
      "id": "lp03crmsync00001-10"
    },
    {
      "parameters": {
