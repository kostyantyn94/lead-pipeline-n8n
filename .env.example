# Copy to .env and adjust. Everything has a working default for the offline demo.

# PostgreSQL (pipeline data in PG_DB, n8n's own tables in database "n8n")
PG_USER=n8n
PG_PASSWORD=n8npass
PG_DB=leads

# n8n
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
TZ=Europe/Kyiv

# LLM: any OpenAI-compatible chat-completions endpoint.
#   offline demo (default):   http://mock-llm:8081/v1          model mock-qualifier
#   OpenAI:                   https://api.openai.com/v1        model gpt-4o-mini
#   Ollama on the host:       http://host.docker.internal:11434/v1   model qwen2.5:14b
LLM_BASE_URL=http://mock-llm:8081/v1
LLM_API_KEY=mock
LLM_MODEL=mock-qualifier
ICP_DESCRIPTION=B2B SaaS companies and agencies with 10-500 employees; buyers are decision makers in sales, marketing or operations who need CRM and workflow automation

# CRM: HubSpot CRM v3 contacts API or the bundled mock that speaks the same subset.
#   offline demo (default):   http://mock-crm:8080     token ignored
#   HubSpot:                  https://api.hubapi.com   token = private app access token
CRM_BASE_URL=http://mock-crm:8080
CRM_TOKEN=mock

# Optional Slack-compatible incoming webhook ({"text": "..."}) for notifications. Empty = off.
NOTIFY_WEBHOOK_URL=

# Fetch the company website <title> during enrichment (slower; off for the demo).
ENRICH_WEBSITE=false

# Chaos switch for the mock LLM: every Nth call fails with HTTP 500 to exercise retries. 0 = never.
MOCK_LLM_FAIL_EVERY=0
